                                        '<span>'+ response.coupon.code+' - ' + 'تم خصم ' + response.coupon.discount_string +'</span>'+
                                        '<button class="removeCoupon" onclick="deleteCoupon()" style="color: inherit; cursor: pointer">'+
                                            '<span class="pe-7s-trash"></span>'+
                                        '</button>'+
                                '</div>');
