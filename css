  overflow: hidden;
  border-radius: 18px;
  background: linear-gradient(180deg, #1a1712 0%, #0e0d0b 100%);
  border: 1px solid rgba(212,175,55,0.16);
  box-shadow:
    0 10px 24px rgba(0,0,0,0.24),
    inset 0 1px 0 rgba(255,230,160,0.04);
}

section[section-id="a251f72a-0eef-4bb3-8d9d-cdf16054b957"] .card-item-inner a {
  display: block;
}

section[section-id="a251f72a-0eef-4bb3-8d9d-cdf16054b957"] .card-item-inner img {
  width: 100%;
  height: auto;
  aspect-ratio: 307 / 451;
  object-fit: cover;
  display: block;
  border-radius: 18px;
  transition: transform 0.35s ease, filter 0.35s ease;
}

section[section-id="a251f72a-0eef-4bb3-8d9d-cdf16054b957"] .card-item:hover .card-item-inner img {
  transform: scale(1.025);
  filter: brightness(1.02);
}

section[section-id="a251f72a-0eef-4bb3-8d9d-cdf16054b957"] .card-content {
  text-align: center;
  padding: 18px 18px 8px;
}

section[section-id="a251f72a-0eef-4bb3-8d9d-cdf16054b957"] .card-content .title {
  margin-bottom: 10px;
  font-size: 25px;
  line-height: 1.3;
  font-weight: 800;
}

section[section-id="a251f72a-0eef-4bb3-8d9d-cdf16054b957"] .card-content .title a {
  color: #fff7e5 !important;
  text-decoration: none !important;
}

section[section-id="a251f72a-0eef-4bb3-8d9d-cdf16054b957"] .card-content .description {
  color: #e8dcc0 !important;
  font-size: 15px;
  line-height: 1.85;
  max-width: 92%;
  margin: 0 auto 18px;
  min-height: 78px;
}

section[section-id="a251f72a-0eef-4bb3-8d9d-cdf16054b957"] .card-content .link.hbtn1 {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  min-width: 150px;
  height: 46px;
  padding: 0 22px;
  border-radius: 999px !important;
  background: linear-gradient(180deg, #e2bd49 0%, #b17d12 100%) !important;
  color: #17130c !important;
  font-weight: 900;
  text-decoration: none !important;
  box-shadow:
    0 10px 22px rgba(0,0,0,0.22),
    inset 0 1px 0 rgba(255,245,200,0.35);
  transition: all 0.22s ease;
}

section[section-id="a251f72a-0eef-4bb3-8d9d-cdf16054b957"] .card-content .link.hbtn1:hover {
  transform: translateY(-2px);
  box-shadow:
    0 12px 26px rgba(0,0,0,0.26),
    0 0 14px rgba(212,175,55,0.20);
}

section[section-id="a251f72a-0eef-4bb3-8d9d-cdf16054b957"] .slick-prev,
section[section-id="a251f72a-0eef-4bb3-8d9d-cdf16054b957"] .slick-next {
  width: 50px !important;
  height: 50px !important;
  border-radius: 999px !important;
  background: linear-gradient(180deg, #e1ba47 0%, #ad7b12 100%) !important;
  box-shadow:
    0 12px 24px rgba(0,0,0,0.26),
    inset 0 1px 0 rgba(255,246,204,0.35) !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
  z-index: 20 !important;
}

section[section-id="a251f72a-0eef-4bb3-8d9d-cdf16054b957"] .slick-prev:hover,
section[section-id="a251f72a-0eef-4bb3-8d9d-cdf16054b957"] .slick-next:hover {
