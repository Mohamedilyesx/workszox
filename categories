                            var checkTotal = total.code = "total" ? 'font-weight: bold;color: var( --primary-color);' : '';
                                totals +=  '<div class="cart-product-row-wrapper cart-totals-row-wrapper">'+
                                    '                                <div class="flex-grow-1">'+total.title+'</div>'+
                                    '                                <div class="flex-shrink-0" style="width: 30%;">'+total.value_string+'</div>'+
                                    '                            </div>'    
                        }
                        $(".cartBox .cart-totals-div").html(totals);

                        } else {
                        $(".cartBox").html(`<div class="overlay"></div><div class="content"><i class="fa fa-close close"></i><div class="cart-empty">
                            <span class="cart-icon">
                                <img src="https://static.zid.store/412ed541/empty-cart2.png?v=v3.0.0" alt="cart-empty">
                            </span>
                            <h1>سلة التسوق فارغة</h1>
                        </div></div>`)
                        }

                        setCartTotalAndBadge(response.cart);

                    $(".cartBox .overlay,.cartBox .close").click(function(){
                        $(".cartBox").removeClass("active");
                        $(".header .giftBox").removeClass("disabled");
                        setTimeout(function(){
                            $(".cartBox").html('');
