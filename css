  box-shadow: 0 8px 24px rgba(0,0,0,.18) !important;
}

.product-item.style1 .mask,
.product-item.style1 .content {
  background: transparent !important;
}

.products-details-page .prodDetails h1 {
    justify-self: center!important;
}

