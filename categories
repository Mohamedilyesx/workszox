async function cartProductsHtmlChanged(html, cart){
    // Check if cart is valid
    if (!cart || typeof cart !== 'object') {
        console.warn('cartProductsHtmlChanged: Invalid cart data provided');
        return;
    }
    
    var prodUrl = '';
    var cartProductId = '';
    var ProductId = '';
    var quantity = '';
    
    // Safely extract URL parameters if event is available
    if (typeof event !== 'undefined' && event && event.currentTarget && event.currentTarget.responseURL) {
        prodUrl = event.currentTarget.responseURL;
        cartProductId = prodUrl.indexOf('cart-product-id=') > -1 ? prodUrl.split('cart-product-id=')[1].split('&')[0] : '';
        ProductId = prodUrl.indexOf('&product-id=') > -1 ? prodUrl.split('&product-id=')[1].split('&')[0] : '';
        quantity = prodUrl.indexOf('quantity=') > -1 ? prodUrl.split('quantity=')[1].split('&')[0] : '';
    }
    
    if((cart.products_count || 0) <= 0){
        $('.cart-products-with-totals').addClass('d-none');
        $('.cart-empty').removeClass('d-none');
        return;
    }else{
        $('.cart-products-with-totals').removeClass('d-none');
        $('.cart-empty').addClass('d-none');
    }

    $('.template_for_cart_products_list').html(html);

    if(cart &&  cart.totals){
        var strCartTotlas = '';
        for(var i = 0; i < cart.totals.length; i++){
            var cartTotal = cart.totals[i];

            var totalStyle = '';

            if(cartTotal.code === 'total'){
                totalStyle = 'font-weight: bold; color: var( --primary-color)';
            }
    
            var vat_included = '';
            if(cartTotal.code === 'total'){

                var is_cart_total_vat_included = false;
                var local_sys_lbl_cart_includes_vat = "شامل الضريبة ";
            
                if(is_cart_total_vat_included){
                    vat_included = '&nbsp;<small>'+local_sys_lbl_cart_includes_vat+'</small>';
                }
                
            }


            strCartTotlas += '<div class="cart-product-row-wrapper cart-totals-row-wrapper">' +
                '                                <div class="flex-grow-1">'+cartTotal.title+vat_included+'</div>' +
                '                                <div class="flex-shrink-0" style="width: 30%; '+totalStyle+'">'+cartTotal.value_string+'</div>' +
                '                            </div>'
        }

        $('.cart-totals-div').html(strCartTotlas);
    }

    if(cart.free_shipping_rule){
        $('.free-shipping-rule-section').removeClass('d-none')
        $('.free-shipping-rule-progress').css('width', `${cart.free_shipping_rule.subtotal_condition.products_subtotal_percentage_from_min}%`)
        if (cart.free_shipping_rule.subtotal_condition.status === 'applied') {
            $('.free-shipping-rule-done').removeClass('d-none')
            $('.free-shipping-rule-read-more').addClass('d-none')
            $('.free-shipping-rule-progress').html('شحن مجاني')
        } else if (cart.free_shipping_rule.subtotal_condition.status === 'min_not_reached') {
            $('.free-shipping-rule-done').addClass('d-none')
            $('.free-shipping-rule-read-more').removeClass('d-none')
            var remainingAmount = cart.free_shipping_rule.subtotal_condition.remaining || "0";
            $('.free-shipping-rule-message').html(`أضف منتجات بقيمة {amount} للحصول على شحن مجاني`.replace('{amount}', remainingAmount))
        } else {
            $('.free-shipping-rule-done').addClass('d-none')
            $('.free-shipping-rule-read-more').removeClass('d-none')
            $('.free-shipping-rule-progress').html(`${cart.free_shipping_rule.subtotal_condition.products_subtotal_percentage_from_min}%`)
        }
    }else{
        $('.free-shipping-rule-section').addClass('d-none')
    }
    
    if(quantity > 0){
        try {
            await zid.store.cart.updateProduct(cartProductId, quantity).then(function (response) {
                if(response.status  === 'success') {
                    window.loadToasterScriptIfNotLoaded(function () {
                    toastr.success( (window.appDirection === 'rtl') ? "تمت الإضافة إلى السلة بنجاح" : "Added to cart successfully" );
                    });
                }
                else{
                    window.loadToasterScriptIfNotLoaded(function () {
                        toastr.error(response.data.message);
                    });
                }
                $('.add-to-cart-progress').addClass('d-none');
            })

        } catch (error) {
            handleErrors(error);
        }
        addDeleteProgressImage();
        if (cart) {
            setCartTotalAndBadge(cart);
        }
        
    }
    else {
        if (cart) {
            setCartTotalAndBadge(cart);
        }
        addDeleteProgressImage();
    }
    $('.cart-product-quantity-dropdown.form-group option:first-of-type').remove();
    
}

