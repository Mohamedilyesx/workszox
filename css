}

section[section-id="a251f72a-0eef-4bb3-8d9d-cdf16054b957"] .slick-prev i,
section[section-id="a251f72a-0eef-4bb3-8d9d-cdf16054b957"] .slick-next i {
  color: #14110c !important;
  font-size: 18px !important;
}

section[section-id="a251f72a-0eef-4bb3-8d9d-cdf16054b957"] .slick-dots li button:before {
