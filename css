  position: relative;
  overflow: hidden;
  border-radius: 20px;
  background: linear-gradient(180deg, #1a1712 0%, #0e0d0b 100%);
  border: 1px solid rgba(212,175,55,0.18);
  box-shadow:
    0 12px 30px rgba(0,0,0,0.28),
